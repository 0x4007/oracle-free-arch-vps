[Unit]
Description=Dated read-only backup, guest telemetry and provisional billing observations
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/pi/ops/weekly-backup-controller
ExecStart=/usr/local/bin/safepi deno run --allow-read=.private --allow-write=.private --allow-run=/home/pi/.venvs/oci/bin/oci scripts/calendar-observations.ts
TimeoutStartSec=15min
UMask=0077
