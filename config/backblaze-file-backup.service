[Unit]
Description=Pi-controlled weekly encrypted VPS file backup to Backblaze
After=network-online.target weekly-backup.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/pi/ops/weekly-backup-controller
# The Pi never moves payloads: the controller transmits only small JSON and
# commands. Reads cover the controller tree (realPath(".") and
# config/restic-excludes.txt), writes stay inside .private, and networking is
# unrestricted in the sandbox because Backblaze returns dynamic pod-*
# subdomains; every URL is still host-validated inside B2Store against the
# exact backblazeb2.com/backblaze.com namespace.
ExecStart=/usr/local/bin/safepi deno run --allow-read=.,.private --allow-write=.private --allow-run --allow-net scripts/backblaze-file-backup.ts
UMask=0077
TimeoutStartSec=7h
Restart=on-failure
RestartSec=30min
