[Unit]
Description=OCI telemetry and Object Storage audit
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/pi/ops/weekly-backup-controller
ExecStart=/bin/bash -c 'set -o pipefail; /usr/local/bin/safepi deno task weekly:audit 2>&1 | cat'
TimeoutStartSec=5min
UMask=0077
